# Copy to .env and fill in what you use.

# --- Telegram (recommended: free, instant, supports links/formatting)
# 1) In Telegram, talk to @BotFather -> /newbot -> copy the token below
# 2) Send "hi" to your new bot, then run:  .venv/bin/python -m minervini telegram-chat-id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- WhatsApp option A: CallMeBot (free, personal use)
# Add +34 644 66 32 62 to contacts and send "I allow callmebot to send me messages"; you get an API key.
CALLMEBOT_PHONE=+852XXXXXXXX
CALLMEBOT_APIKEY=

# --- WhatsApp option B: Twilio (paid, more reliable)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_WHATSAPP_TO=whatsapp:+852XXXXXXXX

# --- Dashboard link sent in messages (e.g. your Tailscale or Cloudflare Tunnel URL)
DASHBOARD_URL=http://localhost:8050/
# Long random string; the link in your messages carries it. Generate: python3 -c "import secrets;print(secrets.token_urlsafe(24))"
DASHBOARD_TOKEN=

# --- SEC EDGAR requires a contact in the User-Agent
SEC_USER_AGENT=SEPA-Scanner personal-research you@example.com

# Optional: account size for position sizing when not syncing from IBKR (USD)
# ACCOUNT_EQUITY=100000
